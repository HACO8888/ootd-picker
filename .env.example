# 複製成 .env 並填入實際值。.env 已被 .gitignore 忽略，切勿提交真實憑證。
# 本機與 production 皆使用此檔；production 請在部署平台的環境變數設定相同的 key。

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# 部署前先跑一次 migration：pnpm db:migrate
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Auth.js ─────────────────────────────────────────────────────────────────
# AUTH_SECRET：用 `npx auth secret` 或 `openssl rand -base64 33` 產生。
# 更換此值會使所有已登入的 session 失效（需重新登入）。
AUTH_SECRET=

# AUTH_URL：應用的對外網址，結尾不要加斜線。
#   本機       → http://localhost:3000
#   production → https://你的正式網域
AUTH_URL=http://localhost:3000

# 反向代理 / 容器 / Serverless 部署時設為 true。
AUTH_TRUST_HOST=true

# ── Google OAuth ────────────────────────────────────────────────────────────
# Google Cloud Console → API 與服務 → 憑證 → OAuth 2.0 用戶端。
# 「授權重新導向 URI」需包含： <AUTH_URL>/api/auth/callback/google
# （本機與 production 的 URI 可並存）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── 對外網址（OG / canonical metadata 用）────────────────────────────────────
# metadataBase / canonical / sitemap / robots 由此決定；未設時預設正式網域
# https://ootd.haco.tw。localhost 或 *.vercel.app 時 robots 會整站 noindex，
# 避免開發／預覽環境被搜尋引擎收錄。結尾不要加斜線。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 管理員 ──────────────────────────────────────────────────────────────────
# 逗號分隔的 email 白名單；登入時命中者自動取得 admin role（bootstrap）。
ADMIN_EMAILS=

# ── AI 輔助（選填）──────────────────────────────────────────────────────────
# 拍照自動建檔（/api/ai/tag）與 AI 造型師（/api/ai/stylist），設定方式與 TPSJ11-AI 相同。
# OpenAI 相容閘道（模型需支援圖片輸入）；僅 server 端使用，絕不可加 NEXT_PUBLIC_ 前綴。
# 未設定時兩個 API 回 503，前台照常運作，AI 按鈕顯示「AI 功能尚未啟用」。
# AI_API_BASE_URL 含 /v1、不含 /chat/completions 後綴。
AI_API_BASE_URL=https://ai.onc.tw/v1
AI_API_KEY=
AI_TEXT_MODEL=gemini-3.8-flash
